import asyncio
import sys
from pathlib import Path

_backend_dir = Path(__file__).resolve().parent.parent
if str(_backend_dir) not in sys.path:
    sys.path.insert(0, str(_backend_dir))

from sqlalchemy import select
from db.session import async_session_maker, engine
from models.admin import Admin
from core.security import verify_password

async def main():
    async with async_session_maker() as db:
        stmt = select(Admin)
        result = await db.execute(stmt)
        admins = result.scalars().all()
        print(f"Found {len(admins)} admins in database:")
        for a in admins:
            print(f"- ID: {a.id}, Email: '{a.email}', Status: '{a.status}', DeletedAt: {a.deleted_at}")
            print(f"  Hash: '{a.password_hash}'")
            # Verify if password "Admin@123" works
            is_valid = verify_password("Admin@123", a.password_hash)
            print(f"  Does 'Admin@123' match? {is_valid}")
            # Verify if password "123456" works
            is_valid_123 = verify_password("123456", a.password_hash)
            print(f"  Does '123456' match? {is_valid_123}")

if __name__ == "__main__":
    asyncio.run(main())
